rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// users/{uid}/trips/{tripId}
//   Required: id (string, immutable and equal to document ID),
//     ownerUid (string, immutable and equal to uid), name (1-40 chars),
//     currency (shared catalog currency code), budget (0..1e12), createdAt (milliseconds since
//     epoch, immutable).
//   Optional: startDate/endDate (YYYY-MM-DD or empty string),
//     travelers (up to 10 {id,name} maps), inviteId (null or invite ID).
//
// users/{uid}/expenses/{expenseId}
//   Required: id (string, immutable and equal to document ID),
//     ownerUid (string, immutable and equal to uid), tripId (immutable ID
//     of a trip owned by uid), amount (>0 and <=1e12), category (1-40
//     chars), method (shared catalog key), note (up to 60 chars), date
//     (YYYY-MM-DD), createdAt (milliseconds since epoch, immutable).
//   Optional: photo (null or bounded JPEG data URL), paidBy (null or ID),
//     participants (null or a list of up to 10 IDs).
//
// users/{uid}/meta/settings
//   Optional fields only: theme (light/dark), homeCurrency (shared catalog currency),
//     optional legacy rates map, activeTripId (null or ID).
//
// users/{uid}/meta/cats
//   Required: list (up to 10 custom category maps containing id, name,
//     icon class, hex color, and custom:true).
//
// tripInvites/{inviteId}
//   ownerUid, tripId, tripName, active, createdAt. Authenticated users
//   can get (not list) active invite documents when holding the invite ID.
//
// tripShares/{ownerUid}/trips/{tripId}/members/{memberUid}
//   A member record is created only as part of accepting that trip's
//   active invite, together with users/{memberUid}/joinedTrips/{key}.
//
// users/{uid}/joinedTrips/{ownerUid}_{tripId}
//   Owner-only membership index used to discover trips joined by uid.
//
// userDirectory/{uid}
//   Opt-in public search record: uid, Google displayName, lowercase
//   searchName, and updatedAt. Email and trip data are never listed.
//
// appConfig/catalog
//   Admin-managed shared catalog: currencyCode, currencySymbol,
//   exchangeRates, categories, categoryIcons, categoryColors, and
//   paymentMethods. Signed-in clients can read but never write it.
//
// collaborationInvites/{inviteId}
//   Targeted invite: ownerUid, ownerName, inviteeUid, tripId, tripName,
//   createdAt, status, and respondedAt after acceptance.
//
// Assumptions: users authenticate with Firebase Auth; trip IDs and
// expense IDs are generated by the app; invite acceptance requires
// both membership records in one transaction. Collaborators can edit
// trip/expense content and delete expenses, but only owners can delete
// trips or change ownership, IDs, timestamps, or invite state. User profile
// documents are not exposed by these rules.
//
// ===============================================================
// Helper Functions
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

function signedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return signedIn() && request.auth.uid == uid;
}

function validId(value) {
  return value is string &&
    value.size() >= 1 &&
    value.size() <= 128 &&
    value.matches('^[A-Za-z0-9_-]+$');
}

function validUid(value) {
  return value is string && value.size() >= 1 && value.size() <= 128;
}

function validShortDate(value) {
  return value is string &&
    (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
}

function validOptionalInviteId(data) {
  return !('inviteId' in data) ||
    data.inviteId == null ||
    validId(data.inviteId);
}

function appCatalogPath() {
  return /databases/$(database)/documents/appConfig/catalog;
}

function isConfiguredCurrency(value) {
  return value is string &&
    exists(appCatalogPath()) &&
    get(appCatalogPath()).data.currencyCode == value;
}

function isConfiguredPaymentMethod(value) {
  return value is string &&
    exists(appCatalogPath()) &&
    value in get(appCatalogPath()).data.paymentMethods.keys();
}

function isTripMember(ownerUid, tripId) {
  return signedIn() &&
    exists(/databases/$(database)/documents/tripShares/$(ownerUid)/trips/$(tripId)/members/$(request.auth.uid));
}

function canAccessTrip(ownerUid, tripId) {
  return isOwner(ownerUid) || isTripMember(ownerUid, tripId);
}

function validTraveler(item) {
  return item is map &&
    item.keys().hasAll(['id', 'name']) &&
    item.keys().hasOnly(['id', 'name']) &&
    validId(item.id) &&
    item.name is string &&
    item.name.size() >= 1 &&
    item.name.size() <= 24;
}

function validTravelers(list) {
  return list is list &&
    list.size() <= 10 &&
    (list.size() < 1 || validTraveler(list[0])) &&
    (list.size() < 2 || validTraveler(list[1])) &&
    (list.size() < 3 || validTraveler(list[2])) &&
    (list.size() < 4 || validTraveler(list[3])) &&
    (list.size() < 5 || validTraveler(list[4])) &&
    (list.size() < 6 || validTraveler(list[5])) &&
    (list.size() < 7 || validTraveler(list[6])) &&
    (list.size() < 8 || validTraveler(list[7])) &&
    (list.size() < 9 || validTraveler(list[8])) &&
    (list.size() < 10 || validTraveler(list[9]));
}

function validTrip(data, ownerUid, tripId) {
  return data is map &&
    data.keys().hasAll(['id', 'ownerUid', 'name', 'currency', 'budget', 'createdAt']) &&
    data.keys().hasOnly([
      'id', 'ownerUid', 'name', 'currency', 'budget', 'startDate',
      'endDate', 'travelers', 'createdAt', 'inviteId'
    ]) &&
    data.id == tripId &&
    data.ownerUid == ownerUid &&
    validId(data.id) &&
    data.name is string &&
    data.name.size() >= 1 &&
    data.name.size() <= 40 &&
    isConfiguredCurrency(data.currency) &&
    data.budget is number &&
    data.budget >= 0 &&
    data.budget <= 1000000000000 &&
    data.createdAt is number &&
    data.createdAt > 0 &&
    data.createdAt <= 4102444800000 &&
    (!('startDate' in data) || validShortDate(data.startDate)) &&
    (!('endDate' in data) || validShortDate(data.endDate)) &&
    (!('travelers' in data) || validTravelers(data.travelers)) &&
    validOptionalInviteId(data);
}

function isExistingTrip(ownerUid, tripId) {
  return exists(/databases/$(database)/documents/users/$(ownerUid)/trips/$(tripId));
}

function activeInvitePath(inviteId) {
  return /databases/$(database)/documents/tripInvites/$(inviteId);
}

function isActiveTripInvite(ownerUid, tripId, inviteId) {
  return validId(inviteId) &&
    exists(activeInvitePath(inviteId)) &&
    get(activeInvitePath(inviteId)).data.active == true &&
    get(activeInvitePath(inviteId)).data.ownerUid == ownerUid &&
    get(activeInvitePath(inviteId)).data.tripId == tripId &&
    isExistingTrip(ownerUid, tripId) &&
    get(/databases/$(database)/documents/users/$(ownerUid)/trips/$(tripId)).data.inviteId == inviteId;
}

function inviteStateIsValid(ownerUid, tripId) {
  let changed = request.resource.data.diff(resource.data).affectedKeys();
  return !changed.hasAny(['inviteId']) ||
    (
      request.resource.data.inviteId is string &&
      existsAfter(activeInvitePath(request.resource.data.inviteId)) &&
      getAfter(activeInvitePath(request.resource.data.inviteId)).data.active == true &&
      getAfter(activeInvitePath(request.resource.data.inviteId)).data.ownerUid == ownerUid &&
      getAfter(activeInvitePath(request.resource.data.inviteId)).data.tripId == tripId
    ) ||
    (
      request.resource.data.inviteId == null &&
      resource.data.inviteId is string &&
      existsAfter(activeInvitePath(resource.data.inviteId)) &&
      getAfter(activeInvitePath(resource.data.inviteId)).data.active == false
    );
}

function validTripUpdate(ownerUid, tripId) {
  return validTrip(request.resource.data, ownerUid, tripId) &&
    request.resource.data.id == resource.data.id &&
    request.resource.data.ownerUid == ownerUid &&
    (!('ownerUid' in resource.data) ||
      request.resource.data.ownerUid == resource.data.ownerUid) &&
    request.resource.data.createdAt == resource.data.createdAt &&
    inviteStateIsValid(ownerUid, tripId);
}

function validParticipants(list) {
  return list is list &&
    list.size() <= 10 &&
    (list.size() < 1 || validId(list[0])) &&
    (list.size() < 2 || validId(list[1])) &&
    (list.size() < 3 || validId(list[2])) &&
    (list.size() < 4 || validId(list[3])) &&
    (list.size() < 5 || validId(list[4])) &&
    (list.size() < 6 || validId(list[5])) &&
    (list.size() < 7 || validId(list[6])) &&
    (list.size() < 8 || validId(list[7])) &&
    (list.size() < 9 || validId(list[8])) &&
    (list.size() < 10 || validId(list[9]));
}

function validPhoto(value) {
  return value == null ||
    (
      value is string &&
      value.size() <= 900000 &&
      value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]*$')
    );
}

function validExpense(data, ownerUid, expenseId) {
  return data is map &&
    data.keys().hasAll([
      'id', 'ownerUid', 'tripId', 'amount', 'category', 'method',
      'note', 'date', 'createdAt'
    ]) &&
    data.keys().hasOnly([
      'id', 'ownerUid', 'tripId', 'amount', 'category', 'method',
      'note', 'date', 'createdAt', 'photo', 'paidBy', 'participants'
    ]) &&
    data.id == expenseId &&
    validId(data.id) &&
    data.ownerUid == ownerUid &&
    validId(data.tripId) &&
    data.amount is number &&
    data.amount > 0 &&
    data.amount <= 1000000000000 &&
    data.category is string &&
    data.category.size() >= 1 &&
    data.category.size() <= 40 &&
    isConfiguredPaymentMethod(data.method) &&
    data.note is string &&
    data.note.size() <= 60 &&
    data.date is string &&
    data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
    data.createdAt is number &&
    data.createdAt > 0 &&
    data.createdAt <= 4102444800000 &&
    (!('photo' in data) || validPhoto(data.photo)) &&
    (!('paidBy' in data) || data.paidBy == null || validId(data.paidBy)) &&
    (!('participants' in data) ||
      data.participants == null ||
      validParticipants(data.participants)) &&
    isExistingTrip(ownerUid, data.tripId);
}

function validExpenseUpdate(ownerUid, expenseId) {
  return validExpense(request.resource.data, ownerUid, expenseId) &&
    request.resource.data.id == resource.data.id &&
    request.resource.data.ownerUid == ownerUid &&
    (!('ownerUid' in resource.data) ||
      request.resource.data.ownerUid == resource.data.ownerUid) &&
    request.resource.data.tripId == resource.data.tripId &&
    request.resource.data.createdAt == resource.data.createdAt;
}

function validRateMap(rates) {
  return rates is map &&
    exists(appCatalogPath()) &&
    rates.keys().size() <= 20 &&
    rates.keys().hasOnly(get(appCatalogPath()).data.exchangeRates.keys());
}

function validSettings(data) {
  return data is map &&
    data.keys().hasOnly(['theme', 'homeCurrency', 'rates', 'activeTripId']) &&
    (!('theme' in data) || data.theme in ['light', 'dark']) &&
    (!('homeCurrency' in data) || isConfiguredCurrency(data.homeCurrency)) &&
    (!('rates' in data) || validRateMap(data.rates)) &&
    (!('activeTripId' in data) || data.activeTripId == null || validId(data.activeTripId));
}

function validHexColor(value) {
  return value is string && value.matches('^#[0-9A-Fa-f]{6}$');
}

function validCategory(item) {
  return item is map &&
    item.keys().hasAll(['id', 'name', 'ic', 'c', 'custom']) &&
    item.keys().hasOnly(['id', 'name', 'ic', 'c', 'custom']) &&
    validId(item.id) &&
    item.name is string &&
    item.name.size() >= 1 &&
    item.name.size() <= 24 &&
    item.ic is string &&
    item.ic.matches('^[A-Za-z0-9 -]{1,80}$') &&
    validHexColor(item.c) &&
    item.custom == true;
}

function validCategories(list) {
  return list is list &&
    list.size() <= 10 &&
    (list.size() < 1 || validCategory(list[0])) &&
    (list.size() < 2 || validCategory(list[1])) &&
    (list.size() < 3 || validCategory(list[2])) &&
    (list.size() < 4 || validCategory(list[3])) &&
    (list.size() < 5 || validCategory(list[4])) &&
    (list.size() < 6 || validCategory(list[5])) &&
    (list.size() < 7 || validCategory(list[6])) &&
    (list.size() < 8 || validCategory(list[7])) &&
    (list.size() < 9 || validCategory(list[8])) &&
    (list.size() < 10 || validCategory(list[9]));
}

function validCatsDocument(data) {
  return data is map &&
    data.keys().hasAll(['list']) &&
    data.keys().hasOnly(['list']) &&
    validCategories(data.list);
}

function validInvite(data, ownerUid, inviteId) {
  return data is map &&
    data.keys().hasAll(['ownerUid', 'tripId', 'tripName', 'active', 'createdAt']) &&
    data.keys().hasOnly(['ownerUid', 'tripId', 'tripName', 'active', 'createdAt']) &&
    data.ownerUid == ownerUid &&
    validId(data.tripId) &&
    data.tripName is string &&
    data.tripName.size() >= 1 &&
    data.tripName.size() <= 40 &&
    data.active is bool &&
    data.createdAt is timestamp &&
    validId(inviteId);
}

function inviteJoinIsValid(ownerUid, tripId, inviteId) {
  let invite = activeInvitePath(inviteId);
  let trip = /databases/$(database)/documents/users/$(ownerUid)/trips/$(tripId);
  return request.auth.uid != ownerUid &&
    isActiveTripInvite(ownerUid, tripId, inviteId) &&
    existsAfter(trip) &&
    existsAfter(invite) &&
    getAfter(invite).data.active == true &&
    getAfter(invite).data.ownerUid == ownerUid &&
    getAfter(invite).data.tripId == tripId &&
    getAfter(trip).data.inviteId == inviteId;
}

function isAcceptedCollaborationInvite(ownerUid, tripId, inviteId, memberUid) {
  let invite = /databases/$(database)/documents/collaborationInvites/$(inviteId);
  return request.auth.uid == memberUid &&
    exists(invite) &&
    get(invite).data.status == 'pending' &&
    existsAfter(invite) &&
    getAfter(invite).data.status == 'accepted' &&
    getAfter(invite).data.ownerUid == ownerUid &&
    getAfter(invite).data.tripId == tripId &&
    getAfter(invite).data.inviteeUid == memberUid &&
    isExistingTrip(ownerUid, tripId);
}

function validMembershipInvite(ownerUid, tripId, inviteId, memberUid) {
  return inviteJoinIsValid(ownerUid, tripId, inviteId) ||
    isAcceptedCollaborationInvite(ownerUid, tripId, inviteId, memberUid);
}

function validMember(data, ownerUid, tripId, memberUid) {
  return data is map &&
    data.keys().hasAll(['uid', 'ownerUid', 'tripId', 'inviteId', 'joinedAt']) &&
    data.keys().hasOnly([
      'uid', 'ownerUid', 'tripId', 'inviteId', 'joinedAt', 'displayName', 'photoURL'
    ]) &&
    data.uid == memberUid &&
    data.ownerUid == ownerUid &&
    data.tripId == tripId &&
    data.inviteId is string &&
    data.joinedAt is timestamp &&
    (!('displayName' in data) ||
      (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80)) &&
    (!('photoURL' in data) || data.photoURL == null ||
      (data.photoURL is string && data.photoURL.size() <= 2048 && data.photoURL.matches('^https://.*'))) &&
    validUid(memberUid) &&
    validMembershipInvite(ownerUid, tripId, data.inviteId, memberUid);
}

function tripOwnerRemovingMember(ownerUid, tripId, memberUid) {
  return signedIn() && request.auth.uid == ownerUid;
}

function pairedJoinedRecordExists(ownerUid, tripId, memberUid, inviteId) {
  let membershipId = ownerUid + '_' + tripId;
  let joined = /databases/$(database)/documents/users/$(memberUid)/joinedTrips/$(membershipId);
  return existsAfter(joined) &&
    getAfter(joined).data.ownerUid == ownerUid &&
    getAfter(joined).data.tripId == tripId &&
    getAfter(joined).data.inviteId == inviteId;
}

function pairedMemberRecordExists(ownerUid, tripId, memberUid, inviteId) {
  let member = /databases/$(database)/documents/tripShares/$(ownerUid)/trips/$(tripId)/members/$(memberUid);
  return existsAfter(member) &&
    getAfter(member).data.uid == memberUid &&
    getAfter(member).data.ownerUid == ownerUid &&
    getAfter(member).data.tripId == tripId &&
    getAfter(member).data.inviteId == inviteId;
}

function canReadOwnerJoinedTrip(memberUid, membershipId) {
  let parts = membershipId.split('_');
  return signedIn() &&
    parts.size() == 2 &&
    parts[0] == request.auth.uid &&
    validId(parts[1]) &&
    exists(/databases/$(database)/documents/tripShares/$(request.auth.uid)/trips/$(parts[1])/members/$(memberUid));
}

function validJoinedTrip(data, membershipId, memberUid) {
  return data is map &&
    data.keys().hasAll(['ownerUid', 'tripId', 'inviteId', 'joinedAt']) &&
    data.keys().hasOnly(['ownerUid', 'tripId', 'inviteId', 'joinedAt']) &&
    validUid(data.ownerUid) &&
    validId(data.tripId) &&
    membershipId == data.ownerUid + '_' + data.tripId &&
    data.inviteId is string &&
    data.joinedAt is timestamp &&
    data.joinedAt == request.time &&
    validMembershipInvite(data.ownerUid, data.tripId, data.inviteId, memberUid) &&
    pairedMemberRecordExists(data.ownerUid, data.tripId, memberUid, data.inviteId);
}

function validDirectoryProfile(data, userId) {
  return data is map &&
    data.keys().hasAll(['uid', 'displayName', 'searchName', 'updatedAt']) &&
    data.keys().hasOnly(['uid', 'displayName', 'searchName', 'updatedAt', 'photoURL']) &&
    data.uid == userId &&
    data.displayName is string &&
    data.displayName.size() >= 1 &&
    data.displayName.size() <= 80 &&
    data.displayName == request.auth.token.name &&
    data.searchName is string &&
    data.searchName.size() >= 1 &&
    data.searchName.size() <= 80 &&
    (!('photoURL' in data) || data.photoURL == null ||
      (data.photoURL is string && data.photoURL.size() <= 2048 && data.photoURL.matches('^https://.*'))) &&
    data.updatedAt == request.time;
}

function validCollaborationInvite(data, inviteId) {
  return data is map &&
    data.keys().hasAll([
      'ownerUid', 'ownerName', 'inviteeUid', 'tripId', 'tripName',
      'createdAt', 'status'
    ]) &&
    data.keys().hasOnly([
      'ownerUid', 'ownerName', 'inviteeUid', 'tripId', 'tripName',
      'createdAt', 'status', 'respondedAt'
    ]) &&
    validUid(data.ownerUid) &&
    data.ownerName is string &&
    data.ownerName.size() >= 1 &&
    data.ownerName.size() <= 80 &&
    data.inviteeUid is string &&
    data.inviteeUid.size() >= 1 &&
    data.inviteeUid.size() <= 128 &&
    data.inviteeUid != data.ownerUid &&
    validId(data.tripId) &&
    data.tripName is string &&
    data.tripName.size() >= 1 &&
    data.tripName.size() <= 40 &&
    data.createdAt is timestamp &&
    data.status in ['pending', 'accepted'] &&
    validId(inviteId) &&
    (!('respondedAt' in data) || data.respondedAt is timestamp);
}

function validCollaborationInviteAcceptance(inviteId) {
  let member = /databases/$(database)/documents/tripShares/$(resource.data.ownerUid)/trips/$(resource.data.tripId)/members/$(request.auth.uid);
  let membershipId = resource.data.ownerUid + '_' + resource.data.tripId;
  let joined = /databases/$(database)/documents/users/$(request.auth.uid)/joinedTrips/$(membershipId);
  let changed = request.resource.data.diff(resource.data).affectedKeys();
  return request.auth.uid == resource.data.inviteeUid &&
    resource.data.status == 'pending' &&
    request.resource.data.status == 'accepted' &&
    request.resource.data.respondedAt == request.time &&
    changed.hasOnly(['status', 'respondedAt']) &&
    validCollaborationInvite(request.resource.data, inviteId) &&
    existsAfter(member) &&
    getAfter(member).data.uid == request.auth.uid &&
    getAfter(member).data.ownerUid == resource.data.ownerUid &&
    getAfter(member).data.tripId == resource.data.tripId &&
    existsAfter(joined) &&
    getAfter(joined).data.ownerUid == resource.data.ownerUid &&
    getAfter(joined).data.tripId == resource.data.tripId;
}

// ===============================================================
// Database Rules — default deny
// ===============================================================

    match /appConfig/{documentId} {
      allow get: if signedIn() && documentId == 'catalog';
      allow list, write: if false;
    }

    match /userDirectory/{userId} {
      // Directory records contain only opted-in public display names.
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create, update: if isOwner(userId) &&
        validDirectoryProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId} {
      // User root documents may contain private information and are unused
      // by the app; deny access to them.
      allow read, write: if false;

      match /trips/{tripId} {
        allow get, list: if isOwner(userId) || isTripMember(userId, tripId);

        allow create: if isOwner(userId) &&
          validTrip(request.resource.data, userId, tripId);

        allow update: if canAccessTrip(userId, tripId) &&
          validTripUpdate(userId, tripId) &&
          (
            isOwner(userId) ||
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['ownerUid', 'inviteId'])
          );

        allow delete: if isOwner(userId);
      }

      match /expenses/{expenseId} {
        allow get, list: if isOwner(userId) ||
          (
            resource.data.tripId is string &&
            isTripMember(userId, resource.data.tripId)
          );

        allow create: if canAccessTrip(userId, request.resource.data.tripId) &&
          validExpense(request.resource.data, userId, expenseId);

        allow update: if canAccessTrip(userId, resource.data.tripId) &&
          validExpenseUpdate(userId, expenseId);

        allow delete: if resource.data.tripId is string &&
          canAccessTrip(userId, resource.data.tripId);
      }

      match /meta/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          (
            (documentId == 'settings' && validSettings(request.resource.data)) ||
            (documentId == 'cats' && validCatsDocument(request.resource.data))
          );
        allow delete: if isOwner(userId) &&
          (documentId == 'settings' || documentId == 'cats');
      }

      match /joinedTrips/{membershipId} {
        allow get: if isOwner(userId) ||
          canReadOwnerJoinedTrip(userId, membershipId) ||
          (signedIn() && resource.data.ownerUid == request.auth.uid &&
            membershipId == request.auth.uid + '_' + resource.data.tripId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          validJoinedTrip(request.resource.data, membershipId, userId);
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid &&
          membershipId == request.auth.uid + '_' + resource.data.tripId;
        allow update: if false;
      }
    }

    match /tripInvites/{inviteId} {
      // An invite ID is a bearer secret. Require authentication and allow
      // direct get only; listing invites is never allowed.
      allow get: if signedIn() &&
        (!exists(activeInvitePath(inviteId)) || resource.data.active == true ||
          resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        validInvite(request.resource.data, request.auth.uid, inviteId) &&
        request.resource.data.active == true &&
        request.resource.data.createdAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/trips/$(request.resource.data.tripId)
        ) &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/trips/$(request.resource.data.tripId)
        ).data.inviteId == inviteId &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/trips/$(request.resource.data.tripId)
        ).data.name == request.resource.data.tripName;

      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        validInvite(request.resource.data, request.auth.uid, inviteId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.tripId == resource.data.tripId &&
        request.resource.data.tripName == resource.data.tripName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        resource.data.active == true &&
        request.resource.data.active == false &&
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/trips/$(resource.data.tripId)
        ).data.inviteId == null;

      allow delete: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        !existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/trips/$(resource.data.tripId)
        );
    }

    match /tripShares/{ownerUid}/trips/{tripId}/members/{memberUid} {
      allow get: if signedIn() &&
        (request.auth.uid == memberUid || request.auth.uid == ownerUid);
      allow list: if isOwner(ownerUid);

      allow create: if signedIn() &&
        request.auth.uid == memberUid &&
        validMember(request.resource.data, ownerUid, tripId, memberUid) &&
        request.resource.data.joinedAt == request.time &&
        pairedJoinedRecordExists(
          ownerUid, tripId, memberUid, request.resource.data.inviteId
        );

      allow update: if false;
      allow delete: if tripOwnerRemovingMember(ownerUid, tripId, memberUid);
    }

    match /collaborationInvites/{inviteId} {
      allow get: if signedIn() &&
        (!exists(/databases/$(database)/documents/collaborationInvites/$(inviteId)) ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.inviteeUid == request.auth.uid);
      allow list: if signedIn() && (
        (resource.data.inviteeUid == request.auth.uid && request.query.limit <= 20) ||
        (resource.data.ownerUid == request.auth.uid && request.query.limit <= 450)
      );

      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        validCollaborationInvite(request.resource.data, inviteId) &&
        request.resource.data.ownerName == request.auth.token.name &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        inviteId == request.auth.uid + '_' + request.resource.data.tripId + '_' + request.resource.data.inviteeUid &&
        exists(/databases/$(database)/documents/userDirectory/$(request.resource.data.inviteeUid)) &&
        !exists(/databases/$(database)/documents/tripShares/$(request.auth.uid)/trips/$(request.resource.data.tripId)/members/$(request.resource.data.inviteeUid)) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/trips/$(request.resource.data.tripId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/trips/$(request.resource.data.tripId)).data.name == request.resource.data.tripName;

      allow update: if signedIn() &&
        validCollaborationInviteAcceptance(inviteId);
      allow delete: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        (
          !existsAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)/trips/$(resource.data.tripId)
          ) ||
          (
            (
              exists(/databases/$(database)/documents/tripShares/$(request.auth.uid)/trips/$(resource.data.tripId)/members/$(resource.data.inviteeUid)) ||
              exists(/databases/$(database)/documents/users/$(resource.data.inviteeUid)/joinedTrips/$(request.auth.uid + '_' + resource.data.tripId))
            ) &&
            !existsAfter(/databases/$(database)/documents/tripShares/$(request.auth.uid)/trips/$(resource.data.tripId)/members/$(resource.data.inviteeUid)) &&
            !existsAfter(/databases/$(database)/documents/users/$(resource.data.inviteeUid)/joinedTrips/$(request.auth.uid + '_' + resource.data.tripId))
          )
        );
    }

    // No other top-level collections or documents are accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
